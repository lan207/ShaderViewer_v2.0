<Window x:Class="ShaderViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:local="clr-namespace:ShaderViewer"
        xmlns:rendering="clr-namespace:ShaderViewer.Rendering"
        Title="Shader Viewer"
        Width="1440"
        Height="920"
        Background="#111318"
        Foreground="#EAEAEA"
        FontFamily="Segoe UI">
    <Window.Resources>
        <x:Array x:Key="ParamTypes" Type="{x:Type sys:String}">
            <sys:String>float</sys:String>
            <sys:String>float2</sys:String>
            <sys:String>float3</sys:String>
            <sys:String>float4</sys:String>
            <sys:String>vec2</sys:String>
            <sys:String>vec3</sys:String>
            <sys:String>vec4</sys:String>
            <sys:String>int</sys:String>
            <sys:String>bool</sys:String>
            <sys:String>sampler2D</sys:String>
        </x:Array>
        <x:Array x:Key="SpriteSortModes" Type="{x:Type rendering:SpriteSortMode}">
            <rendering:SpriteSortMode>Deferred</rendering:SpriteSortMode>
            <rendering:SpriteSortMode>Immediate</rendering:SpriteSortMode>
            <rendering:SpriteSortMode>Texture</rendering:SpriteSortMode>
            <rendering:SpriteSortMode>BackToFront</rendering:SpriteSortMode>
            <rendering:SpriteSortMode>FrontToBack</rendering:SpriteSortMode>
        </x:Array>
        <x:Array x:Key="SpriteBlendStates" Type="{x:Type rendering:SpriteBlendState}">
            <rendering:SpriteBlendState>AlphaBlend</rendering:SpriteBlendState>
            <rendering:SpriteBlendState>Additive</rendering:SpriteBlendState>
            <rendering:SpriteBlendState>Opaque</rendering:SpriteBlendState>
            <rendering:SpriteBlendState>NonPremultiplied</rendering:SpriteBlendState>
        </x:Array>
        <x:Array x:Key="SpriteSamplerStates" Type="{x:Type rendering:SpriteSamplerState}">
            <rendering:SpriteSamplerState>PointClamp</rendering:SpriteSamplerState>
            <rendering:SpriteSamplerState>LinearClamp</rendering:SpriteSamplerState>
            <rendering:SpriteSamplerState>PointWrap</rendering:SpriteSamplerState>
            <rendering:SpriteSamplerState>LinearWrap</rendering:SpriteSamplerState>
            <rendering:SpriteSamplerState>AnisotropicClamp</rendering:SpriteSamplerState>
            <rendering:SpriteSamplerState>AnisotropicWrap</rendering:SpriteSamplerState>
        </x:Array>
        <x:Array x:Key="SpriteDepthStencilStates" Type="{x:Type rendering:SpriteDepthStencilState}">
            <rendering:SpriteDepthStencilState>None</rendering:SpriteDepthStencilState>
            <rendering:SpriteDepthStencilState>Default</rendering:SpriteDepthStencilState>
            <rendering:SpriteDepthStencilState>DepthRead</rendering:SpriteDepthStencilState>
        </x:Array>
        <SolidColorBrush x:Key="PanelBrush" Color="#1A1F28" />
        <SolidColorBrush x:Key="PanelBrush2" Color="#222833" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7DA8FF" />
        <DrawingBrush x:Key="CheckerboardBrush" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFE8E8E8" Geometry="M0,0 L24,0 24,24 0,24Z" />
                    <GeometryDrawing Brush="#FFD0D0D0" Geometry="M0,0 L12,0 12,12 0,12Z M12,12 L24,12 24,24 12,24Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style x:Key="ReadableParamTypeItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Padding" Value="6,3" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#FFD9E8FF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFBFD7FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Padding="12"
                Margin="0,0,0,12"
                Background="{StaticResource PanelBrush}"
                CornerRadius="12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="OpenShaderButton" Content="Open Shader" Margin="0,0,8,0" Padding="14,6" Click="OpenShader_Click" />
                    <Button x:Name="CompileButton" Content="Compile / Apply" Margin="0,0,8,0" Padding="14,6" Click="Compile_Click" />
                    <Button x:Name="SpriteBatchButton" Content="Open SpriteBatch Preview" Margin="0,0,8,0" Padding="14,6" Click="OpenSpriteBatch_Click" />
                    <Button x:Name="ExportButton" Content="Export Shader" Margin="0,0,8,0" Padding="14,6" Click="ExportShader_Click" />
                    <Button x:Name="ResetButton" Content="Reset Defaults" Padding="14,6" Click="Reset_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#B9C3D7" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0"
                Padding="12"
                Margin="0,0,12,0"
                Background="{StaticResource PanelBrush}"
                CornerRadius="12">
            <Grid>
                <Border x:Name="PreviewCanvas"
                        Background="{StaticResource CheckerboardBrush}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                    <Border x:Name="PreviewHost"
                            Background="Transparent"
                            CornerRadius="8"
                            SnapsToDevicePixels="True" />
                </Border>
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="12"
                        Padding="8,4"
                        Background="#AA10131A"
                        CornerRadius="6">
                    <TextBlock Text="iInput = first texture. iChannel0..2 = extra textures. ScreenShaderData: uColor/uProgress/uTargetPosition/etc. Right-down positive coordinates. Max preview profile: ps_3_0."
                               Foreground="#D6DCE8"
                               FontSize="12" />
                </Border>
            </Grid>
        </Border>

        <TabControl x:Name="EditorTabs"
                    Grid.Row="1" Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    BorderThickness="0"
                    Padding="8"
                    Foreground="#EAEAEA">
            <TabItem Header="Textures">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding TextureSlots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="10"
                                        Background="{StaticResource PanelBrush2}"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding RequirementText}"
                                                   Foreground="#B9C3D7"
                                                   FontSize="12"
                                                   Margin="0,0,0,6" />
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                                     MinWidth="250"
                                                     Margin="0,0,8,0" />
                                            <Button Content="Browse" Padding="12,4" Click="BrowseTexture_Click" Tag="{Binding}" />
                                        </DockPanel>
                                        <Border Height="96" Background="#0D0F14" CornerRadius="6" Padding="4">
                                            <Image Source="{Binding Preview}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <TextBlock Text="{Binding Warning}"
                                                   Foreground="#FFD166"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Params">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Add Param" Padding="12,4" Click="AddParam_Click" />
                            <TextBlock Margin="10,4,0,0"
                                       Foreground="#B9C3D7"
                                       Text="Default and ScreenShaderData parameters are editable; resolution and live clock values are read-only." />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ParameterSlots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="10"
                                            Background="{StaticResource PanelBrush2}"
                                            CornerRadius="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     Foreground="#EAEAEA"
                                                     Background="#0D0F14"
                                                     BorderBrush="#667085"
                                                     IsReadOnly="{Binding IsNameReadOnly}"
                                                     MinWidth="120"
                                                     Margin="0,0,8,0" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{StaticResource ParamTypes}"
                                                      Foreground="Black"
                                                      Background="White"
                                                      ItemContainerStyle="{StaticResource ReadableParamTypeItemStyle}"
                                                      SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsTypeEditable}"
                                                      Margin="0,0,8,0" />
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     Foreground="#EAEAEA"
                                                     Background="#0D0F14"
                                                     BorderBrush="#667085"
                                                     IsReadOnly="{Binding IsReadOnly}"
                                                     MinWidth="140"
                                                     Margin="0,0,8,0" />
                                            <Button Grid.Column="3"
                                                    Content="Remove"
                                                    Padding="12,4"
                                                    IsEnabled="{Binding CanRemove}"
                                                    Click="RemoveParam_Click"
                                                    Tag="{Binding}" />
                                            <TextBlock Grid.ColumnSpan="4"
                                                       Grid.Row="1"
                                                       Margin="0,6,0,0"
                                                       Foreground="#B9C3D7"
                                                       FontSize="11"
                                                       Text="{Binding Description}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="SpriteBatch">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="SpriteBatch.Begin draw parameters"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="These values mirror Microsoft.Xna.Framework.Graphics.SpriteBatch. Use Open SpriteBatch Preview to render through the generated MonoGame backend; the embedded WPF preview remains available for quick shader iteration."
                                   TextWrapping="Wrap"
                                   Foreground="#B9C3D7"
                                   FontSize="12"
                                   Margin="0,0,0,12" />
                        <TextBlock Text="SpriteSortMode" Margin="0,0,0,4" />
                        <ComboBox x:Name="SpriteSortModeBox"
                                  ItemsSource="{StaticResource SpriteSortModes}"
                                  SelectedIndex="0"
                                  SelectionChanged="SpriteBatchSetting_Changed"
                                  Margin="0,0,0,10" />
                        <TextBlock Text="BlendState" Margin="0,0,0,4" />
                        <ComboBox x:Name="SpriteBlendStateBox"
                                  ItemsSource="{StaticResource SpriteBlendStates}"
                                  SelectedIndex="0"
                                  SelectionChanged="SpriteBatchSetting_Changed"
                                  Margin="0,0,0,10" />
                        <TextBlock Text="SamplerState" Margin="0,0,0,4" />
                        <ComboBox x:Name="SpriteSamplerStateBox"
                                  ItemsSource="{StaticResource SpriteSamplerStates}"
                                  SelectedIndex="1"
                                  SelectionChanged="SpriteBatchSetting_Changed"
                                  Margin="0,0,0,10" />
                        <TextBlock Text="DepthStencilState" Margin="0,0,0,4" />
                        <ComboBox x:Name="SpriteDepthStencilStateBox"
                                  ItemsSource="{StaticResource SpriteDepthStencilStates}"
                                  SelectedIndex="0"
                                  SelectionChanged="SpriteBatchSetting_Changed"
                                  Margin="0,0,0,10" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="ScreenShaderData">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ScreenShaderData parameters"
                                   Foreground="#EAEAEA"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Common Terraria/tModLoader screen-filter values. Changes are applied to the in-process preview and forwarded to the MonoGame preview when it is opened. Colors use float3(r, g, b); vectors use x, y."
                                   TextWrapping="Wrap"
                                   Foreground="#B9C3D7"
                                   FontSize="12"
                                   Margin="0,0,0,12" />
                        <TextBlock Text="uColor / UseColor (float3)" Foreground="#EAEAEA" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ScreenShaderData.Color, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#EAEAEA" Background="#0D0F14" BorderBrush="#667085"
                                 TextChanged="ScreenShaderData_Changed"
                                 Margin="0,0,0,8" />
                        <TextBlock Text="uSecondaryColor / uSecondColor / UseSecondaryColor (float3)" Foreground="#EAEAEA" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ScreenShaderData.SecondaryColor, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#EAEAEA" Background="#0D0F14" BorderBrush="#667085"
                                 TextChanged="ScreenShaderData_Changed"
                                 Margin="0,0,0,8" />
                        <TextBlock Text="uOpacity / UseOpacity" Foreground="#EAEAEA" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ScreenShaderData.Opacity, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#EAEAEA" Background="#0D0F14" BorderBrush="#667085"
                                 TextChanged="ScreenShaderData_Changed"
                                 Margin="0,0,0,8" />
                        <TextBlock Text="uIntensity / UseIntensity" Foreground="#EAEAEA" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ScreenShaderData.Intensity, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#EAEAEA" Background="#0D0F14" BorderBrush="#667085"
                                 TextChanged="ScreenShaderData_Changed"
                                 Margin="0,0,0,8" />
                        <TextBlock Text="uProgress / UseProgress" Foreground="#EAEAEA" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ScreenShaderData.Progress, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#EAEAEA" Background="#0D0F14" BorderBrush="#667085"
                                 TextChanged="ScreenShaderData_Changed"
                                 Margin="0,0,0,8" />
                        <TextBlock Text="uDirection / UseDirection (float2)" Foreground="#EAEAEA" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ScreenShaderData.Direction, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#EAEAEA" Background="#0D0F14" BorderBrush="#667085"
                                 TextChanged="ScreenShaderData_Changed"
                                 Margin="0,0,0,8" />
                        <TextBlock Text="uTargetPosition / UseTargetPosition" Foreground="#EAEAEA" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ScreenShaderData.TargetPosition, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#EAEAEA" Background="#0D0F14" BorderBrush="#667085"
                                 TextChanged="ScreenShaderData_Changed"
                                 Margin="0,0,0,8" />
                        <TextBlock Text="uImageOffset / UseImageOffset" Foreground="#EAEAEA" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ScreenShaderData.ImageOffset, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#EAEAEA" Background="#0D0F14" BorderBrush="#667085"
                                 TextChanged="ScreenShaderData_Changed"
                                 Margin="0,0,0,8" />
                        <TextBlock Text="uImageScale / UseImageScale" Foreground="#EAEAEA" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ScreenShaderData.ImageScale, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#EAEAEA" Background="#0D0F14" BorderBrush="#667085"
                                 TextChanged="ScreenShaderData_Changed"
                                 Margin="0,0,0,8" />
                        <TextBlock Text="uGlobalOpacity / UseGlobalOpacity" Foreground="#EAEAEA" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ScreenShaderData.GlobalOpacity, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#EAEAEA" Background="#0D0F14" BorderBrush="#667085"
                                 TextChanged="ScreenShaderData_Changed"
                                 Margin="0,0,0,8" />
                        <TextBlock Text="uScreenPosition (float2, world pixels)" Foreground="#EAEAEA" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ScreenShaderData.ScreenPosition, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#EAEAEA" Background="#0D0F14" BorderBrush="#667085"
                                 TextChanged="ScreenShaderData_Changed"
                                 Margin="0,0,0,8" />
                        <TextBlock Text="uZoom (float2)" Foreground="#EAEAEA" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ScreenShaderData.Zoom, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#EAEAEA" Background="#0D0F14" BorderBrush="#667085"
                                 TextChanged="ScreenShaderData_Changed"
                                 Margin="0,0,0,8" />
                        <StackPanel Margin="0,0,0,10">
                            <WrapPanel Margin="0,0,0,6">
                                <Button Content="Load Terraria Vortex Filter"
                                        Padding="12,4"
                                        Margin="0,0,8,0"
                                        Click="LoadTerrariaVortexFilter_Click" />
                                <Button Content="Save as custom scheme"
                                        Padding="12,4"
                                        Margin="0,0,8,0"
                                        Click="AddScreenShaderDataProfile_Click" />
                                <Button Content="Load scheme file"
                                        Padding="12,4"
                                        Click="LoadScreenShaderDataProfile_Click" />
                            </WrapPanel>
                            <TextBlock Foreground="#B9C3D7"
                                       TextWrapping="Wrap"
                                       Text="Custom schemes are persisted as .screen.json files. Save captures the current values; Load restores files from disk." />
                        </StackPanel>
                        <Button Content="Reset ScreenShaderData" Padding="12,4" Click="ResetScreenShaderData_Click" />
                        <TextBlock x:Name="ScreenShaderDataHint"
                                   Foreground="#FFD166"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Filters.Scene">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Terraria-style scene filter manager"
                                   Foreground="#EAEAEA"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Register shader sources as named filters, activate/deactivate them with Terraria's one-second fade, and render the visible filters through ping-pong screen targets in priority order. Stacks are persisted as .filters.json files."
                                   TextWrapping="Wrap"
                                   Foreground="#B9C3D7"
                                   FontSize="12"
                                   Margin="0,0,0,12" />
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="Register current shader" Padding="12,4" Margin="0,0,8,6" Click="RegisterCurrentSceneFilter_Click" />
                            <Button Content="Save filter stack" Padding="12,4" Margin="0,0,8,6" Click="SaveSceneFilterStack_Click" />
                            <Button Content="Load filter stack" Padding="12,4" Margin="0,0,8,6" Click="LoadSceneFilterStack_Click" />
                            <Button Content="Deactivate all" Padding="12,4" Margin="0,0,8,6" Click="DeactivateAllSceneFilters_Click" />
                        </WrapPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Filter limit" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding SceneFilterLimit, UpdateSourceTrigger=PropertyChanged}" Foreground="#EAEAEA" Background="#0D0F14" BorderBrush="#667085" />
                            <TextBlock Grid.Column="3" Text="Priority threshold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="4" ItemsSource="{Binding SceneFilterPriorities}" SelectedItem="{Binding SceneFilterPriorityThreshold}" />
                        </Grid>
                        <TextBlock Text="Registered filters" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding SceneFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="10" Background="{StaticResource PanelBrush2}" CornerRadius="10">
                                        <StackPanel>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     Foreground="#EAEAEA" Background="#0D0F14" BorderBrush="#667085"
                                                     FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding SourceSummary}" Foreground="#8FA1BE" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <WrapPanel Margin="0,0,0,8">
                                                <TextBlock Text="Priority" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <ComboBox Width="100" ItemsSource="{Binding DataContext.SceneFilterPriorities, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Priority}" Margin="0,0,12,0" />
                                                <CheckBox Content="Active" IsChecked="{Binding Active}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <CheckBox Content="Hidden" IsChecked="{Binding IsHidden}" VerticalAlignment="Center" />
                                            </WrapPanel>
                                            <WrapPanel>
                                                <Button Content="Edit" Padding="10,3" Margin="0,0,6,0" Tag="{Binding}" Click="EditSceneFilter_Click" />
                                                <Button Content="Capture current" Padding="10,3" Margin="0,0,6,0" Tag="{Binding}" Click="UpdateSceneFilter_Click" />
                                                <Button Content="Remove" Padding="10,3" Tag="{Binding}" Click="RemoveSceneFilter_Click" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Canvas">
                <StackPanel>
                    <TextBlock Text="Preview geometry" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="Surface renders the shader over the whole canvas. Sprite modes reproduce the centered DrawData rectangle used by Terraria projectiles; ForceField uses the 2:1 scale from ForceField.PreDraw and supplies a procedural shield texture when no image is selected."
                               TextWrapping="Wrap"
                               Foreground="#B9C3D7"
                               FontSize="12"
                               Margin="0,0,0,10" />
                    <ComboBox x:Name="PreviewGeometryBox"
                              SelectedIndex="0"
                              SelectionChanged="PreviewGeometry_Changed"
                              Margin="0,0,0,14">
                        <ComboBoxItem Tag="surface" Content="Surface (full canvas)" />
                        <ComboBoxItem Tag="sprite" Content="Centered sprite (1:1)" />
                        <ComboBoxItem Tag="forcefield" Content="ForceField DrawData (2:1 sprite)" />
                        <ComboBoxItem Tag="scene-filter" Content="Filters.Scene (screen RenderTarget pass)" />
                    </ComboBox>
                    <TextBlock Text="ScreenShaderData schemes" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="Saved schemes are shown here with their parameter values. Apply or update a scheme, or delete it when it is no longer needed."
                               TextWrapping="Wrap"
                               Foreground="#B9C3D7"
                               FontSize="12"
                               Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding ScreenShaderDataProfiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="10"
                                        Background="{StaticResource PanelBrush2}"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right"
                                                    Content="Delete"
                                                    Padding="10,3"
                                                    Tag="{Binding}"
                                                    Click="DeleteScreenShaderDataProfile_Click" />
                                            <Button DockPanel.Dock="Right"
                                                    Content="Update"
                                                    Padding="10,3"
                                                    Margin="0,0,6,0"
                                                    Tag="{Binding}"
                                                    Click="UpdateScreenShaderDataProfile_Click" />
                                            <Button DockPanel.Dock="Right"
                                                    Content="Apply"
                                                    Padding="10,3"
                                                    Margin="0,0,6,0"
                                                    Tag="{Binding}"
                                                    Click="ApplyScreenShaderDataProfile_Click" />
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     Foreground="#EAEAEA"
                                                     Background="#0D0F14"
                                                     BorderBrush="#667085"
                                                     FontWeight="SemiBold"
                                                     MinWidth="140" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Values.Color, StringFormat=uColor: {0}}" Foreground="#D6DCE8" />
                                        <TextBlock Text="{Binding Values.SecondaryColor, StringFormat=uSecondaryColor: {0}}" Foreground="#D6DCE8" />
                                        <TextBlock Text="{Binding Values.Opacity, StringFormat=uOpacity: {0}}" Foreground="#D6DCE8" />
                                        <TextBlock Text="{Binding Values.Intensity, StringFormat=uIntensity: {0}}" Foreground="#D6DCE8" />
                                        <TextBlock Text="{Binding Values.Progress, StringFormat=uProgress: {0}}" Foreground="#D6DCE8" />
                                        <TextBlock Text="{Binding Values.Direction, StringFormat=uDirection: {0}}" Foreground="#D6DCE8" />
                                        <TextBlock Text="{Binding Values.TargetPosition, StringFormat=uTargetPosition: {0}}" Foreground="#D6DCE8" />
                                        <TextBlock Text="{Binding Values.ImageOffset, StringFormat=uImageOffset: {0}}" Foreground="#D6DCE8" />
                                        <TextBlock Text="{Binding Values.ImageScale, StringFormat=uImageScale: {0}}" Foreground="#D6DCE8" />
                                        <TextBlock Text="{Binding Values.GlobalOpacity, StringFormat=uGlobalOpacity: {0}}" Foreground="#D6DCE8" />
                                        <TextBlock Text="{Binding Values.ScreenPosition, StringFormat=uScreenPosition: {0}}" Foreground="#D6DCE8" />
                                        <TextBlock Text="{Binding Values.Zoom, StringFormat=uZoom: {0}}" Foreground="#D6DCE8" />
                                        <TextBlock Text="{Binding FilePath}"
                                                   Foreground="#8FA1BE"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource Self}}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>
                    <TextBlock Text="Transparent background" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="Checkerboard makes transparent pixels visible. Solid color accepts #AARRGGBB (or #RRGGBB); the alpha channel is preserved."
                               TextWrapping="Wrap"
                               Foreground="#B9C3D7"
                               FontSize="12"
                               Margin="0,0,0,12" />
                    <TextBlock Text="Background mode" Margin="0,0,0,4" />
                    <ComboBox x:Name="BackgroundModeBox" SelectedIndex="0" SelectionChanged="BackgroundMode_Changed" Margin="0,0,0,10">
                        <ComboBoxItem Content="Checkerboard" />
                        <ComboBoxItem Content="Solid color" />
                    </ComboBox>
                    <TextBlock Text="Solid color (#AARRGGBB)" Margin="0,0,0,4" />
                    <DockPanel>
                        <TextBox x:Name="BackgroundColorBox" Text="#FFFFFFFF" Margin="0,0,8,0" />
                        <Button Content="Apply" Padding="12,4" Click="BackgroundColor_Apply" />
                    </DockPanel>
                    <TextBlock x:Name="BackgroundColorHint" Text="" Foreground="#FFD166" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </TabItem>

            <TabItem x:Name="DiagnosticsTab" Header="Diagnostics">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,8"
                               Foreground="#B9C3D7"
                               Text="Every compiler diagnostic shows the source FX file, line, and column when supplied by the HLSL compiler." />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Diagnostics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="10"
                                            Background="{StaticResource PanelBrush2}"
                                            CornerRadius="8">
                                        <TextBlock Text="{Binding DisplayText}"
                                                   TextWrapping="Wrap"
                                                   Foreground="#FFD166" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource Self}}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="Source">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,8"
                               Foreground="#B9C3D7"
                               Text="The first texture is the preview input (iInput). Use main(float2 uv : TEXCOORD0) : COLOR0; XnbFxDecompiler pseudo-FX files are normalized automatically (v0 = white SpriteBatch color, t0 = UV). WPF preview supports up to ps_3_0; higher profiles are tried as ps_3_0 compatibility." />
                    <TextBox x:Name="SourceBox"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="13"
                             TextWrapping="NoWrap"
                             Background="#0D0F14"
                             Foreground="#F2F2F2"
                             BorderThickness="1"
                             BorderBrush="#333D4D"
                             CaretBrush="White" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
